# Copy this file to .dev.vars and replace the placeholders with a local-only
# Google OAuth client. Add http://localhost:8787/auth/google/callback to its
# authorized redirect URIs. Never reuse production secrets here.
NFD_OWNER_EMAIL=developer@example.com
GOOGLE_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Optional. Leave blank to keep automatic post review unavailable locally.
GEMINI_API_KEY=
